<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B3C9A21-4D5E-4F60-9C11-EVBOTS000001}</ProjectGuid>
    <RootNamespace>EVBots</RootNamespace>
    <ProjectName>EVBots</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!--
    Конфигурация одна: Release x86.
    bf3.exe и bf3_server_Final.exe — 32-битные, DLL должна быть x86.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'"
                 Label="Configuration">
    <OutputType>DynamicLibrary</OutputType>
    <TargetName>EVBots</TargetName>
    <TargetExt>.dll</TargetExt>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>
        WIN32_LEAN_AND_MEAN;_WINDOWS;_USRDLL;UNICODE;_UNICODE;
        _CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <ExceptionHandling>Sync</ExceptionHandling>
      <!--
        Structured Exception Handling НЕ отключаем: перехватываем мусорные
        адреса через __try/__except, это часть механизма хуков.
      -->
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\ModdingInterface.cpp" />
    <ClCompile Include="src\EngineHooks.cpp" />
    <ClCompile Include="src\InlineHook.cpp" />
    <ClCompile Include="src\EVBotsLog.cpp" />
    <ClCompile Include="src\EVBots.TestApi.cpp" />

    <!--
      Lua 5.4.2 (MIT). Подключаем только ядро: linit.c и все файлы из lauxlib,
      кроме lua.c/luac.c (это инструменты командной строки).
    -->
    <ClCompile Include="thirdparty\lua-5.4.2\src\*.c">
      <ExcludedFromBuild>lua.c;luac.c;onelua.c</ExcludedFromBuild>
      <PreprocessorDefinitions>LUA_USE_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\ModdingInterface.h" />
    <ClInclude Include="src\EngineHooks.h" />
    <ClInclude Include="src\InlineHook.h" />
    <ClInclude Include="src\EVBotsLog.h" />
    <ClInclude Include="thirdparty\lua-5.4.2\src\lua.h" />
    <ClInclude Include="thirdparty\lua-5.4.2\src\luaconf.h" />
    <ClInclude Include="thirdparty\lua-5.4.2\src\lualib.h" />
    <ClInclude Include="thirdparty\lua-5.4.2\src\lauxlib.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="BLASE-FIELDS.md" />
  </ItemGroup>

</Project>