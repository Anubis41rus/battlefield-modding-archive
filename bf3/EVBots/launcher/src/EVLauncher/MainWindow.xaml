<Window x:Class="EVBots.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EVBots.Launcher"
        Title="EV Launcher — Battlefield 3" Width="1120" Height="780" MinWidth="760" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" Icon="evbots.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Собственный фон встроен в сборку и доступен без BF-Portable. -->
        <Image x:Name="BgImage" Source="Artwork/launcher-background.png" Grid.RowSpan="3" Margin="-24" Stretch="UniformToFill" Opacity="0.95"
               IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle Grid.RowSpan="3" Margin="-24" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#440B0F14" Offset="0"/>
                    <GradientStop Color="#110B0F14" Offset="0.45"/>
                    <GradientStop Color="#B80B0F14" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Шапка: видна всегда -->
        <Grid Grid.Row="0" Margin="4,0,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <!-- 20.10: логотип BF3 из BF-Portable\htdocs\img (bf3Logo.png) -->
            <StackPanel Orientation="Horizontal">
                <Image Source="Artwork/battle-royale-icon.png" Width="72" Height="72" Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Bahnschrift" FontSize="25" FontWeight="Bold" Text="EV LAUNCHER"/>
                    <TextBlock FontSize="10" Foreground="#EAA566" Text="B A T T L E F I E L D  3   /   L A N"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Dim}" Text="Ищу игру и сервер..."/>
            <TextBlock x:Name="MyIpText" Margin="0,2,0,0" Foreground="{StaticResource Good}" FontWeight="Bold"/>
        </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Top" Padding="14,9" Margin="0,6,0,0" BorderBrush="#526D8293" BorderThickness="0,0,0,1">
                <TextBlock Text="BATTLE ROYALE   /   ЛОКАЛЬНАЯ СЕТЬ" FontFamily="Bahnschrift" FontSize="12" Foreground="#C7D4DD"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=AuthPanel}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Grid.Column="1" MaxWidth="440" Height="230" VerticalAlignment="Top" Margin="12,24,0,0">
                <local:RoyaleWordmark Width="440" Height="230" AutomationProperties.Name="BF3 Battle Royale"/>
            </Viewbox>
        </Grid>

        <!-- Экран 1: вход или регистрация -->
        <Border x:Name="AuthPanel" Grid.Row="1" Margin="0,22,0,22" Padding="26"
                Background="#EB0C1721" BorderBrush="#BFDA8C49" BorderThickness="2,0,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Width="440" MaxWidth="560">
            <!-- 19.10: на низком экране (ноутбук, масштаб 125–150%) экран входа прокручивается, а не обрезается -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="10" Foreground="#EAA566" Text="П О Д К Л Ю Ч Е Н И Е   /   L A N" Margin="0,0,0,8"/>
                <TextBlock FontFamily="Bahnschrift" FontSize="30" FontWeight="Bold" Text="ТВОЙ БОЕЦ"/>
                <TextBlock Margin="0,6,0,14" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                           Text="Выбери сервер и войди в свой аккаунт.&#10;Создаёшь сервер? Выбери «Этот ПК»."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Сервер:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2" x:Name="ServerPick"
                              SelectionChanged="ServerPick_Changed"
                              ToolTip="Серверы из этой сети находятся сами. «Этот ПК» — если поднимаешь сервер здесь."/>
                    <Label Grid.Row="1" Content="Логин:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" x:Name="LoginBox"
                             ToolTip="3..32 символа: буквы, цифры, _ - ."/>
                    <Label Grid.Row="2" Content="Пароль:"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" Margin="0,2" x:Name="PasswordBox"
                                 ToolTip="Минимум 4 символа."/>
                    <Label Grid.Row="3" Content="Ник в игре:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" x:Name="NickBox"
                             ToolTip="Имя солдата в игре. Поменяешь и нажмёшь «Войти» — в игре будет новый ник (если он не занят)."/>
                    <Label Grid.Row="4" Content="IP вручную:" x:Name="ManualLabel" Visibility="Collapsed"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" x:Name="HostBox" Visibility="Collapsed"
                             ToolTip="IP хоста, например 192.168.0.10. Нужен, только если сервера друга нет в списке."/>
                </Grid>
                <WrapPanel Margin="0,14,0,0">
                    <Button x:Name="LoginBtn" Content="ВОЙТИ  →" Click="Login_Click" MinWidth="190" Style="{StaticResource PrimaryButton}"
                            ToolTip="Вход в уже созданный аккаунт."/>
                    <Button x:Name="RegisterBtn" Content="Регистрация" Click="Register_Click" MinWidth="170"
                            ToolTip="Создать новый аккаунт на сервере."/>
                </WrapPanel>
                <Expander Header="Настройки и диагностика" Foreground="#AABCCB" Margin="0,4,0,4">
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="CheckBtn" Content="Проверить файлы" Click="Check_Click" MinWidth="150"
                            ToolTip="Пишет в лог, что найдено (игра, сервер, мод, EVBots, активация, бэкенд, .NET, фаервол, URL-ACL) и чего не хватает."/>
                    <Button x:Name="FirewallBtn" Content="Фаервол (UAC)" Click="Firewall_Click" MinWidth="150"
                            ToolTip="Один раз на каждом ПК, и хосту, и гостю: URL-ACL для входа, порты, разрешение bf3.exe. Потом перезапусти сервер, если он был запущен."/>
                    <Button x:Name="EVBotsDirBtn" Content="Указать папку EVBots…" Click="EVBotsDir_Click"
                            ToolTip="Если папка EVBots лежит не рядом с Battlefield 3 и BF-Portable, выбери её вручную."/>
                </WrapPanel>
                </Expander>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                           Text="Твой профиль и прогресс хранятся на выбранном сервере."/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Экран 2: после входа. 19.10: в прокрутке и без строки «*» — у друга на низком экране блок
             «Войти в игру» сплющился в полоску, кнопка обрезалась целиком, игру было не запустить. -->
        <ScrollViewer x:Name="MainPanel" Grid.Row="1" Margin="0,10,0,0" Background="#E8101923" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Сменить пользователя" Click="Logout_Click"
                        ToolTip="Выйти и вернуться к экрану входа."/>
                <TextBlock x:Name="AccountText" VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>

            <!-- Единственный режим: локальный Battle Royale. -->
            <GroupBox x:Name="HostGroup" Grid.Row="1" Header="ЛОКАЛЬНЫЙ СЕРВЕР" Padding="12">
                <StackPanel>
                    <TextBlock Text="BATTLE ROYALE / LAN" FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProfileNote" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#C4A56B"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                        <Label Content="Имя сервера:"/>
                        <TextBox Grid.Column="1" x:Name="ServerNameBox" Text="Battle Royale LAN" Margin="0,0,16,0"/>
                        <Label Grid.Column="2" Content="Частота:"/>
                        <ComboBox Grid.Column="3" x:Name="FreqBox" ToolTip="Частота сервера: 30, 60 или 120 Гц. Применяется при запуске."/>
                    </Grid>
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="HostBtn" Content="СОЗДАТЬ СЕРВЕР" Click="Host_Click" MinWidth="190" Style="{StaticResource PrimaryButton}"/>
                        <Button x:Name="StopBtn" Content="Остановить" Click="Stop_Click"/>
                    </WrapPanel>
                    <!-- Совместимость сохранённых настроек; элементы не входят в интерфейс Royale. -->
                    <StackPanel Visibility="Collapsed">
                        <ComboBox x:Name="ProfileBox"/><ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed"/>
                        <ComboBox x:Name="MapBox"/><ComboBox x:Name="BotsBox"/>
                        <ComboBox x:Name="TicketsBox"/><ComboBox x:Name="TimeBox"/>
                        <ListBox x:Name="RotationList"/><ComboBox x:Name="RoundsBox"/>
                        <Button x:Name="RotAddBtn"/><Button x:Name="RotDelBtn"/><Button x:Name="RotUpBtn"/>
                        <Button x:Name="RotApplyBtn"/><Button x:Name="NextMapBtn"/>
                        <CheckBox x:Name="JetsBox"/><CheckBox x:Name="DefendBox"/><ComboBox x:Name="SkillBox"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Для всех: вход в игру -->
            <GroupBox Grid.Row="2" Header="ПОДКЛЮЧИТЬСЯ К МАТЧУ" Padding="12">
                <StackPanel Margin="8">
                <TextBlock x:Name="ActiveModsText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <!-- 19.10: список, «Обновить» и «Войти в игру» — в одну строку, кнопка всегда на виду -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Margin="0,0,8,0" x:Name="ServerBox" MinWidth="280" VerticalContentAlignment="Center"
                              ToolTip="Серверы на выбранном при входе сервере."/>
                    <Button Grid.Column="1" x:Name="RefreshBtn" Content="Обновить" Click="Refresh_Click"/>
                    <Button Grid.Column="2" x:Name="JoinBtn" Content="Войти в игру" Click="Join_Click" MinWidth="150" Style="{StaticResource PrimaryButton}"
                            ToolTip="Запустит Battlefield 3 и подключит к Battle Royale. В лобби нажми Ready."/>
                </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>
        </ScrollViewer>

        <!-- Лог: виден всегда (и при входе помогает) -->
        <Expander x:Name="LogPanel" Grid.Row="2" Header="ЖУРНАЛ ПОДКЛЮЧЕНИЯ" Foreground="#AABCCB" FontSize="10" Background="#BB0B1119" Padding="10,8">
        <TextBox Margin="0,10,0,0" Height="86" Background="#DC0B1119" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"/>
        </Expander>
    </Grid>
</Window>
