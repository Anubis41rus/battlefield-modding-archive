diff --git a/ui/src/components/MenuScreen.test.tsx b/ui/src/components/MenuScreen.test.tsx
new file mode 100644
index 0000000..98e469c
--- /dev/null
+++ b/ui/src/components/MenuScreen.test.tsx
@@ -0,0 +1,51 @@
+import React from "react";
+import { act, fireEvent, render, screen, cleanup } from "@testing-library/react";
+import MenuScreen from "./MenuScreen";
+import { sendToLua } from "../Helpers";
+
+jest.mock("react-redux", () => ({ connect: () => (component: any) => component }));
+jest.mock("../Helpers", () => ({ sendToLua: jest.fn() }));
+jest.mock("../helpers/SoundHelper", () => ({ PlaySound: jest.fn(), Sounds: {} }));
+
+const showMenu = () => render(React.createElement(MenuScreen as any, {
+    team: [{ name: "LAN Player", isTeamLeader: true, color: "rgba(255,0,0,1)" }],
+    localPlayerName: "LAN Player",
+}));
+afterEach(() => { cleanup(); jest.clearAllMocks(); });
+
+test("five original menu actions route team and inventory to Lua", () => {
+    const { container } = showMenu();
+    expect(Array.from(container.querySelectorAll(".buttonsHolder button")).map(b => b.textContent))
+        .toEqual(["Resume", "Team / Squad", "Inventory", "Options", "Quit"]);
+    fireEvent.click(screen.getByRole("button", { name: "Team / Squad" }));
+    expect(sendToLua).toHaveBeenLastCalledWith("WebUI:TriggerMenuFunction", "team");
+    fireEvent.click(screen.getByRole("button", { name: "Inventory" }));
+    expect(sendToLua).toHaveBeenLastCalledWith("WebUI:TriggerMenuFunction", "inventory");
+    expect(container.querySelector(".MenuSidebar .CreditsBox")).not.toBeNull();
+});
+
+test("team details and unavailable notices consume keyboard confirmation", () => {
+    showMenu();
+    act(() => window.OnMenuTeamDetails());
+    expect(screen.getByText("LAN Player [LEADER]")).not.toBeNull();
+    act(() => window.OnMenuEnter());
+    expect(screen.queryByText("LAN Player [LEADER]")).toBeNull();
+    expect(sendToLua).not.toHaveBeenCalled();
+    act(() => window.OnMenuUnavailable("Deploy before opening inventory."));
+    expect(screen.getByText("Deploy before opening inventory.")).not.toBeNull();
+    act(() => window.OnMenuEsc());
+    expect(screen.queryByText("Deploy before opening inventory.")).toBeNull();
+    expect(sendToLua).not.toHaveBeenCalled();
+});
+
+test("quit requires confirmation and cancellation does not send quit", () => {
+    showMenu();
+    fireEvent.click(screen.getByRole("button", { name: "Quit" }));
+    expect(sendToLua).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "Cancel" }));
+    expect(sendToLua).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "Quit" }));
+    fireEvent.click(screen.getByRole("button", { name: "OK" }));
+    expect(sendToLua).toHaveBeenCalledTimes(1);
+    expect(sendToLua).toHaveBeenCalledWith("WebUI:TriggerMenuFunction", "quit");
+});
