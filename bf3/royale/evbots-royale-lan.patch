+-- Both F10 and the Escape menu use this route. Only the waiting/warmup
+-- states may return to deployment; the running round only shows its roster.
+function VuBattleRoyaleHud:OpenTeamLobby()
+	local s_Player = PlayerManager:GetLocalPlayer()
+	if not self.m_IsLevelLoaded or s_Player == nil or m_HudUtils:GetIsInOptionsMenu() then
+		return false
+	end
+
+	if self.m_GameState ~= GameStates.None and self.m_GameState ~= GameStates.Warmup then
+		if not m_HudUtils:GetIsInEscMenu() then
+			m_EscMenu:OnOpenEscapeMenu()
+		end
+		WebUI:ExecuteJS("OnMenuTeamDetails();")
+		return true
+	end
+
+	if m_HudUtils:GetIsInEscMenu() then
+		m_EscMenu:OnResume()
+	end
+	if m_HudUtils:GetIsInDeployScreen() then
+		return true
+	end
+	if m_HudUtils:GetIsMapOpened() then
+		m_HudUtils:SetIsMapOpened(false)
+		WebUI:ExecuteJS("OnOpenCloseMap(false);")
+	end
+	m_DeployScreen:OpenDeployScreen()
+	if s_Player.soldier ~= nil then
+		NetEvents:Send(PlayerEvents.Despawn)
+	end
+	return true
+end
+
+function VuBattleRoyaleHud:GetInventoryUnavailableReason(p_FromEscapeMenu)
+	local s_Player = PlayerManager:GetLocalPlayer()
+	if not self.m_IsLevelLoaded or s_Player == nil then
+		return "Inventory is available after joining the level."
+	elseif m_HudUtils:GetIsInOptionsMenu() or m_HudUtils:GetIsInDeployScreen() then
+		return "Inventory is available after deployment."
+	elseif m_HudUtils:GetIsInEscMenu() and not p_FromEscapeMenu then
+		return "Close the menu to open inventory."
+	elseif SpectatorManager:GetSpectating() or s_Player.soldier == nil or s_Player.alive == false then
+		return "Inventory is available while your soldier is alive."
+	elseif self.m_IsPlayerOnPlane or self.m_GameState == GameStates.WarmupToPlane
+		or self.m_GameState == GameStates.Plane or self.m_GameState == GameStates.PlaneToFirstCircle then
+		return "Inventory is unavailable during the plane phase."
+	end
+	return nil
+end
+
+function VuBattleRoyaleHud:OpenInventoryFromEscapeMenu()
+	local s_Reason = self:GetInventoryUnavailableReason(true)
+	if s_Reason ~= nil then
+		WebUI:ExecuteJS("OnMenuUnavailable(" .. json.encode(s_Reason) .. ");")
+		return false
+	end
+	m_EscMenu:OnResume()
+	return self:OpenInventory()
+end
+
 function VuBattleRoyaleHud:OpenInventory()
+	if self:GetInventoryUnavailableReason(false) ~= nil then
+		return false
+	end
